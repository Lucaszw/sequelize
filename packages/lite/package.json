{
  "bugs": "https://github.com/sequelize/sequelize/issues",
  "description": "Lightweight, browser-side Sequelize for PGlite with offline change sync to a Sequelize backend",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./lib/server/index.d.mts",
        "default": "./lib/server/index.mjs"
      },
      "require": {
        "types": "./lib/server/index.d.ts",
        "default": "./lib/server/index.js"
      }
    }
  },
  "files": [
    "lib",
    "skills"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "homepage": "https://sequelize.org",
  "license": "MIT",
  "name": "@sequelize/lite",
  "repository": "https://github.com/sequelize/sequelize",
  "scripts": {
    "build": "../../build-packages.mjs lite",
    "test": "concurrently \"npm:test-*\"",
    "test-typings": "tsc --noEmit --project tsconfig.json",
    "test-unit": "mocha \"test/unit/**/*.test.ts\" -r ../../test/register-esbuild.js",
    "test-integration-postgres": "mocha \"test/integration/**/*.test.ts\" -r ../../test/register-esbuild.js",
    "example": "node example/build.mjs && node example/dist/server.js"
  },
  "type": "commonjs",
  "version": "7.0.0-alpha.48",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/validator": "^13.15.10",
    "validator": "^13.15.35"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.2.0",
    "@sequelize/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@sequelize/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@sequelize/core": "workspace:*",
    "@sequelize/postgres": "workspace:*",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "chai": "6.3.0",
    "concurrently": "10.0.6",
    "mocha": "12.0.3"
  }
}
